{
  "name": "xbrecipewriter",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.15.1",
    "@expo/vector-icons": "^15.0.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@tamagui/animations-react-native": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tamagui/font-inter": "^2.7.7",
    "@tamagui/native": "^2.7.7",
    "@tamagui/portal": "^2.7.7",
    "@tamagui/react-native-media-driver": "^2.7.7",
    "@tamagui/shorthands": "^2.7.7",
    "@tamagui/themes": "^2.7.7",
    "buffer": "^6.0.3",
    "expo": "^57.0.15",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "^1.1.13",
    "react-native-uuid": "~2.0.4",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
