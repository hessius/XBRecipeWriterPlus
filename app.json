{
  "expo": {
    "name": "XBRW++",
    "slug": "XBRecipeWriterPlus",
    "owner": "hessius",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xbrecipewriter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.hessius.xbrecipewriterplus"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "package": "com.hessius.xbrecipewriterplus"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          },
          "ios": {
            "ccacheEnabled": true
          }
        }
      ],
      "expo-router",
      [
        "react-native-nfc-manager",
        {
          "includeNdefEntitlement": false,
          "nfcPermission": "This app uses NFC to read and write xBloom coffee recipe cards held near your iPhone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-share-intent",
      "expo-font",
      "expo-sqlite",
      "./plugins/withInhibitPodWarnings",
      "./plugins/withShareExtensionCcache"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "575e9fca-63b7-4375-a01f-f81318c887eb"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
