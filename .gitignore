# No trailing slash: a git worktree commonly symlinks node_modules back to the
# main checkout, and "node_modules/" matches directories only -- so the symlink
# was not ignored and `git add -A` committed it. Checking such a commit out into
# a normal clone then fails with "cannot rmdir 'node_modules'".
node_modules
android/
.expo/
ios/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.ipa
*.psd
*.apk
*.aab
*.mobileprovision
*.orig.*
web-build/
AgentResources/

# macOS
.DS_Store

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli


# Every local env file, not just .env.local: .env.production.local is one typo
# away from being committed, and it would carry the service account's password.
.env*
credentials.json
/.idea/

# Agent skills (installed locally, not part of the app)
.agents/
skills-lock.json

.superpowers/

# Git worktrees
.worktrees/

# Jest writes this in CI so an intermittent failure can name itself (#91).
jest-results.json
